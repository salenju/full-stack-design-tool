{
  "name": "@fsdt/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "fsdt 命令行：lint / compile / gen / sample / export / init / diff / serve / link",
  "bin": {
    "fsdt": "./dist/main.js"
  },
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fsdt/compiler": "workspace:*",
    "@fsdt/core-ir": "workspace:*",
    "@fsdt/exporter": "workspace:*",
    "@fsdt/generator-nestjs": "workspace:*",
    "@fsdt/generator-vue": "workspace:*",
    "@fsdt/generators-runtime": "workspace:*",
    "@fsdt/importer": "workspace:*",
    "@fsdt/lint": "workspace:*",
    "@fsdt/sample": "workspace:*",
    "@fsdt/server": "workspace:*"
  }
}
